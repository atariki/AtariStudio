#include "@GENERATED_SOURCE@"

#include <iostream>

namespace
{

word6502 lastInterruptTarget = 0;
bool lastInterruptReturning = false;

void CaptureInterrupt(
    word6502 target,
    bool returning)
{
    lastInterruptTarget = target;
    lastInterruptReturning = returning;
}

bool Expect(
    bool condition,
    const char* message)
{
    if (!condition)
    {
        std::cerr
            << "FAILED: "
            << message
            << '\n';
    }

    return condition;
}

} // namespace

int main()
{
    memory.fill(0xCC);

    A = 1;
    X = 2;
    Y = 3;
    SP = 4;
    P = 5;

    C = true;
    D = true;
    I = true;
    V = true;
    N = true;
    Z = true;

    initialize_image6502();

    bool passed = true;

    passed &=
        Expect(
            memory[0x0000] == 0x00,
            "uninitialized memory must be cleared");

    passed &=
        Expect(
            memory[0x02E0] == 0x00 &&
            memory[0x02E1] == 0x05,
            "RUNAD bytes must be embedded");

    passed &=
        Expect(
            memory[0x0500] == 0xA2 &&
            memory[0x0501] == 0x00,
            "entry-point bytes must be embedded");

    passed &=
        Expect(
            memory[0xBBFF] == 0x39,
            "last initialized hello.xex byte must be embedded");

    passed &=
        Expect(
            A == 0 &&
            X == 0 &&
            Y == 0 &&
            SP == 0xFF &&
            P == 0 &&
            !C &&
            !D &&
            !I &&
            !V &&
            !N &&
            !Z,
            "CPU state must be reset");

    memory[0xFFFF] = 0x34;
    memory[0x0000] = 0x12;

    passed &=
        Expect(
            word(0xFFFF) == 0x1234,
            "word reads must wrap at the 16-bit address boundary");

    adc6502(
        0x7F,
        0x00,
        true,
        false,
        &A,
        &C,
        &V,
        &N,
        &Z);

    passed &=
        Expect(
            A == 0x80 &&
            !C &&
            V &&
            N &&
            !Z,
            "binary ADC must update result and C/V/N/Z");

    adc6502(
        0xFF,
        0x00,
        true,
        false,
        &A,
        &C,
        &V,
        &N,
        &Z);

    passed &=
        Expect(
            A == 0x00 &&
            C &&
            !V &&
            !N &&
            Z,
            "binary ADC carry and zero result");

    adc6502(
        0x49,
        0x51,
        false,
        true,
        &A,
        &C,
        &V,
        &N,
        &Z);

    passed &=
        Expect(
            A == 0x00 &&
            C &&
            N &&
            !Z,
            "NMOS decimal ADC result, carry, and binary N/Z");

    sbc6502(
        0x00,
        0x01,
        true,
        false,
        &A,
        &C,
        &V,
        &N,
        &Z);

    passed &=
        Expect(
            A == 0xFF &&
            !C &&
            !V &&
            N &&
            !Z,
            "binary SBC borrow and negative result");

    sbc6502(
        0x00,
        0x01,
        true,
        true,
        &A,
        &C,
        &V,
        &N,
        &Z);

    passed &=
        Expect(
            A == 0x99 &&
            !C &&
            N &&
            !Z,
            "decimal SBC result and binary N/Z");

    adc16_6502(
        0x0049,
        0x0051,
        false,
        true,
        &memory16[0x2000],
        &A,
        &C,
        &V,
        &N,
        &Z);

    passed &=
        Expect(
            word(0x2000) == 0x0100 &&
            A == 0x01 &&
            !C &&
            !N &&
            !Z,
            "wide decimal ADC must propagate BCD carry to the high byte");

    sbc16_6502(
        0x0100,
        0x0001,
        true,
        true,
        &memory16[0x2000],
        &A,
        &C,
        &V,
        &N,
        &Z);

    passed &=
        Expect(
            word(0x2000) == 0x0099 &&
            A == 0x00 &&
            C &&
            !N &&
            Z,
            "wide decimal SBC must propagate BCD borrow to the high byte");

    compare6502(
        0x10,
        0x20,
        &C,
        &N,
        &Z);

    passed &=
        Expect(
            !C &&
            N &&
            !Z,
            "CMP semantics");

    test_bits6502(
        0x0F,
        0xC0,
        &V,
        &N,
        &Z);

    passed &=
        Expect(
            V &&
            N &&
            Z,
            "BIT semantics");

    A = 0;
    C = false;
    N = false;
    Z = false;

    asl6502(
        0x81,
        &A,
        &C,
        &N,
        &Z);

    passed &=
        Expect(
            A == 0x02 &&
            C &&
            !N &&
            !Z,
            "ASL semantics");

    ror6502(
        0x01,
        true,
        &A,
        &C,
        &N,
        &Z);

    passed &=
        Expect(
            A == 0x80 &&
            C &&
            N &&
            !Z,
            "ROR semantics");

    SP = 0xFF;
    memory[0x01FF] = 0;

    push(0x5A);

    passed &=
        Expect(
            SP == 0xFE &&
            memory[0x01FF] == 0x5A &&
            pop() == 0x5A &&
            SP == 0xFF,
            "6502 stack push and pull semantics");

    SP = 0xFF;
    C = true;
    Z = true;
    I = false;
    D = true;
    V = true;
    N = false;

    push_status6502();

    passed &=
        Expect(
            SP == 0xFE &&
            memory[0x01FF] == 0x7B,
            "PHP must pack flags with constant and break bits");

    C = false;
    Z = false;
    I = true;
    D = false;
    V = false;
    N = true;

    pull_status6502();

    passed &=
        Expect(
            SP == 0xFF &&
            C &&
            Z &&
            !I &&
            D &&
            V &&
            !N &&
            P == 0x7B,
            "PLP must restore processor flags from the stack");

    memory[0xFFFE] = 0x78;
    memory[0xFFFF] = 0x56;

    SP = 0xFF;
    C = true;
    Z = true;
    I = false;
    D = true;
    V = true;
    N = false;

    interrupt6502 =
        &CaptureInterrupt;

    brk6502(0x2000);

    passed &=
        Expect(
            SP == 0xFC &&
            memory[0x01FF] == 0x20 &&
            memory[0x01FE] == 0x02 &&
            memory[0x01FD] == 0x7B &&
            I &&
            lastInterruptTarget == 0x5678 &&
            !lastInterruptReturning,
            "BRK must push PC/status and dispatch through the IRQ vector");

    C = false;
    Z = false;
    D = false;
    V = false;
    N = true;

    const word6502 restoredProgramCounter =
        rti6502();

    passed &=
        Expect(
            restoredProgramCounter == 0x2002 &&
            SP == 0xFF &&
            C &&
            Z &&
            !I &&
            D &&
            V &&
            !N &&
            lastInterruptTarget == 0x2002 &&
            lastInterruptReturning,
            "RTI must restore status/PC and dispatch the return target");

    const auto entry =
        &run_entry6502;

    passed &=
        Expect(
            entry != nullptr,
            "generated entry wrapper must link");

    return passed ? 0 : 1;
}
